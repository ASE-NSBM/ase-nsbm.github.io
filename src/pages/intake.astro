---
import PageLayout from '@/layouts/PageLayout.astro'
import { Image } from 'astro:assets'
import logo from '@/assets/logo.svg'

const frontmatter = {
  title: 'Join ASE 2026 | Association of Software Engineering',
  description: 'Join the premier software engineering community at NSBM. Be part of groundbreaking events, innovative projects, and a vibrant tech community.',
  activeHeaderLink: 'Join Us',
  searchable: true,
  fullWidth: true
}

const stats = [
  { number: '15+', label: 'Major Events', icon: 'tabler--trophy', colorClass: 'text-blue-400', bgClass: 'from-blue-500/5' },
  { number: '100+', label: 'Active Members', icon: 'tabler--users-group', colorClass: 'text-green-400', bgClass: 'from-green-500/5' },
  { number: '10+', label: 'Industry Partners', icon: 'tabler--building-skyscraper', colorClass: 'text-purple-400', bgClass: 'from-purple-500/5' },
]

const values = [
  { 
    title: 'Innovation', 
    desc: 'Pushing boundaries with cutting-edge tech',
    icon: 'tabler--bulb', 
    class: 'col-span-2 md:col-span-1 bg-white border-blue-100 dark:bg-transparent dark:bg-gradient-to-br dark:from-blue-500/10 dark:to-transparent dark:border-blue-500/20' 
  },
  { 
    title: 'Community', 
    desc: 'A family of passionate developers',
    icon: 'tabler--users', 
    class: 'col-span-2 md:col-span-1 bg-white border-green-100 dark:bg-transparent dark:bg-gradient-to-br dark:from-green-500/10 dark:to-transparent dark:border-green-500/20' 
  },
  { 
    title: 'Excellence', 
    desc: 'Setting the standard for student organizations',
    icon: 'tabler--award', 
    class: 'col-span-2 bg-white border-purple-100 dark:bg-transparent dark:bg-gradient-to-br dark:from-purple-500/10 dark:to-transparent dark:border-purple-500/20' 
  }
]

const events = [
  { name: 'ASE Summit 25', category: 'Summit', image: '/events/ASESummit.webp' },
  { name: 'Sleigh the Flag', category: 'CTF', image: '/events/SleightheFlag.webp' },
  { name: 'Tech Carnival 25', category: 'Carnival', image: '/events/TechCarnival25.webp' },
  { name: 'GreenEXE 3.0', category: 'Hackathon', image: '/events/GreenEXE3.0GrandFinal.webp' },
  { name: 'EduSathkara', category: 'CSR', image: '/events/EduSathkara.webp' },
  { name: 'Subcommittee Badging', category: 'Ceremony', image: '/events/SubcommitteeBadging.webp' },
  { name: 'Py League 25', category: 'Competition', image: '/events/PyLeauge25.webp' },
  { name: 'IFS AI & DS Workshop', category: 'Workshop', image: '/events/IFSAI&DSWorkshop.webp' },
  { name: "Inauguration 25'", category: 'Ceremony', image: "/events/Inaugration25'.webp" },
  { name: 'Game Dev Workshop', category: 'Workshop', image: '/events/GameDevelopment.webp' },
  { name: 'MadFest', category: 'Exhibition', image: '/events/MadFest.webp' },
  { name: 'GreenEXE 2.0', category: 'Hackathon', image: '/events/GreenEXE2.0.webp' }
]

const testimonials = [
  {
    name: 'Darren Victoria',
    role: 'President, ASE 2025',
    quote: "Leading ASE has been the most transformative experience. We don't just organize events; we create experiences that shape careers.",
    image: '/ASE_Circle/topboard/darren.webp'
  },
  {
    name: 'Raminda Kariyawasam',
    role: 'Vice President, ASE 2025',
    quote: "ASE represents the future. Our subcommittee members aren't just volunteers; they're innovators and future tech leaders.",
    image: '/ASE_Circle/topboard/raminda.webp'
  }
]

const joinLink = "https://docs.google.com/forms/d/e/1FAIpQLSegVqugYTNno-qUbEVzhNfVXHwHt8XuXnr56s1ks9MDAfliDg/viewform?usp=dialog"
---

<PageLayout {frontmatter}>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex flex-col items-center justify-center overflow-hidden pt-20 pb-10 bg-slate-100 dark:bg-transparent transition-colors duration-500">
    <!-- Animated Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-60 dark:opacity-100 transition-opacity duration-500">
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-green-600/10 rounded-full blur-[100px] animate-pulse-slow delay-1000"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-radial from-white/5 to-transparent blur-3xl dark:opacity-100 opacity-0"></div>
    </div>

    <div class="container relative z-10 mx-auto px-4 text-center">
      <!-- Title Area -->
      <div class="mb-12 relative inline-block">
         <!-- Glowing backdrop for title -->
         <div class="absolute -inset-20 bg-gradient-to-r from-blue-600/30 via-green-500/30 to-purple-600/30 blur-3xl rounded-full opacity-60 animate-pulse-slow dark:opacity-60 opacity-30"></div>
         
         <h1 class="relative text-7xl md:text-9xl font-black tracking-tighter leading-none mb-2 animate-fade-in-up delay-100 select-none text-black dark:text-white dark:mix-blend-overlay dark:opacity-50">
            REDEFINE
         </h1>
         <h1 class="relative text-7xl md:text-9xl font-black tracking-tighter leading-none -mt-4 md:-mt-8 mb-6 animate-fade-in-up delay-200 z-10 drop-shadow-2xl">
            <span class="text-transparent bg-clip-text bg-gradient-to-b from-slate-800 via-slate-700 to-slate-500 dark:from-white dark:via-white dark:to-white/40">POSSIBLE</span>
         </h1>
         
         <div class="text-2xl md:text-4xl font-light tracking-[0.5em] uppercase text-blue-600/80 dark:text-blue-300/80 animate-fade-in-up delay-300">
            Intake <span class="text-slate-900 dark:text-white font-bold">2026</span>
         </div>
      </div>

      <p class="text-xl md:text-3xl text-black font-bold dark:text-white/50 dark:font-light dark:text-lg dark:md:text-2xl max-w-3xl mx-auto mb-16 leading-relaxed animate-fade-in-up delay-300">
        We are not just a club. We are a movement. <br class="hidden md:block" />
        <span class="text-black dark:text-white/80">Defining the future of software engineering at NSBM.</span>
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center animate-fade-in-up delay-300">
        <a href={joinLink} target="_blank" rel="noopener noreferrer" class="group relative px-10 py-5 bg-white border-slate-200 text-slate-900 hover:bg-slate-50 dark:bg-white/5 dark:backdrop-blur-md dark:border-white/10 dark:text-white dark:hover:bg-white/10 font-bold rounded-none overflow-hidden transition-all duration-300 hover:tracking-widest uppercase text-sm border shadow-sm dark:shadow-none">
          <span class="relative z-10 flex items-center gap-3">
            Initialize Application
            <span class="iconify tabler--terminal text-green-600 dark:text-green-400"></span>
          </span>
          <div class="absolute inset-x-0 bottom-0 h-[2px] bg-gradient-to-r from-blue-500 via-green-500 to-blue-500 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
        
        <a href="#about" class="px-8 py-5 text-slate-500 hover:text-slate-900 dark:text-white/40 dark:hover:text-white transition-colors text-sm uppercase tracking-widest font-medium group flex items-center gap-2">
          Explore Protocol
          <span class="iconify tabler--chevron-down group-hover:translate-y-1 transition-transform"></span>
        </a>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-50 text-slate-400 dark:text-white">
      <span class="iconify tabler--chevron-down text-3xl"></span>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="py-20 border-y border-slate-200 bg-slate-100 dark:border-white/5 dark:bg-black/20 transition-colors duration-500">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {stats.map((stat, i) => (
          <div class="relative group p-8 rounded-2xl bg-white border-slate-200 shadow-sm dark:bg-white/5 dark:border-white/5 dark:shadow-none hover:border-slate-300 dark:hover:border-white/10 transition-all hover:-translate-y-1 overflow-hidden">
            <div class={`absolute inset-0 bg-gradient-to-br ${stat.bgClass} to-transparent opacity-0 group-hover:opacity-100 transition-opacity`}></div>
            <div class="relative z-10 flex flex-col items-center">
              <span class={`iconify ${stat.icon} text-4xl mb-4 ${stat.colorClass}`}></span>
              <span class="text-5xl font-black text-slate-900 dark:font-bold dark:bg-clip-text dark:text-transparent dark:bg-gradient-to-b dark:from-white dark:to-white/50">{stat.number}</span>
              <span class="text-black font-bold text-base dark:text-white/60 dark:mt-2 dark:font-medium dark:tracking-wide dark:uppercase dark:text-sm">{stat.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values (Bento Grid) -->
  <section id="about" class="py-32 bg-white dark:bg-transparent transition-colors duration-500">
    <div class="container mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 class="text-5xl md:text-6xl font-black mb-6 text-black dark:text-4xl dark:md:text-5xl dark:font-bold dark:text-white">Why Choose ASE?</h2>
        <p class="text-xl text-black font-bold dark:text-lg dark:text-white/60 dark:font-normal">We provide the platform, you bring the passion. Together we redefine what's possible in student-led innovation.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <!-- Large Card Left -->
        <div class="lg:col-span-2 lg:row-span-2 relative rounded-3xl overflow-hidden group min-h-[400px] border border-slate-200 dark:border-white/5 shadow-sm dark:shadow-none bg-slate-900">
          <Image src={logo} alt="ASE Logo" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-8">
             <div class="w-12 h-12 rounded-xl bg-blue-600/20 flex items-center justify-center mb-4 backdrop-blur-sm border border-blue-500/30">
              <span class="iconify tabler--star text-2xl text-blue-400"></span>
            </div>
            <h3 class="text-3xl font-bold mb-2 text-white">Premiere Status</h3>
            <p class="text-white/70">The most active and influential tech community at NSBM, recognized for excellence in event organization and technical prowess.</p>
          </div>
        </div>

        <!-- Smaller Cards -->
        {values.map((value) => (
          <div class={`relative p-8 rounded-3xl border backdrop-blur-sm hover:translate-y-[-4px] transition-transform duration-300 shadow-sm dark:shadow-none ${value.class}`}>
            <div class="w-10 h-10 rounded-lg bg-slate-200 dark:bg-white/10 flex items-center justify-center mb-4">
              <span class={`iconify ${value.icon} text-xl text-black dark:text-white`}></span>
            </div>
            <h3 class="text-2xl font-black mb-2 text-black dark:text-xl dark:font-bold dark:text-white">{value.title}</h3>
            <p class="text-base text-black font-bold dark:text-sm dark:text-white/60 dark:font-normal">{value.desc}</p>
          </div>
        ))}
        
        <!-- Image Card -->
        <div class="lg:col-span-2 relative rounded-3xl overflow-hidden group min-h-[200px] bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/5 shadow-sm dark:shadow-none">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-green-600 opacity-10 dark:opacity-20 group-hover:opacity-20 dark:group-hover:opacity-30 transition-opacity"></div>
          <div class="absolute inset-0 flex items-center justify-center">
             <span class="text-2xl font-bold tracking-widest uppercase text-slate-900 dark:text-white opacity-80">Be The Elite</span>
          </div>
        </div>

        <!-- Governance Card -->
        <a href="/terms" class="lg:col-span-2 relative rounded-3xl overflow-hidden group min-h-[200px] border border-slate-200 dark:border-white/10 hover:border-blue-500/30 transition-all bg-white dark:bg-transparent shadow-sm dark:shadow-none">
          <div class="absolute inset-0 bg-slate-50 dark:bg-white/5 backdrop-blur-sm group-hover:bg-slate-100 dark:group-hover:bg-white/10 transition-colors"></div>
          <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10">
             <span class="font-mono text-lg md:text-xl text-slate-600 dark:text-white/70 group-hover:text-slate-900 dark:group-hover:text-white transition-colors leading-relaxed">
               Learn from our <br/>
               <span class="text-blue-600 dark:text-blue-400 font-bold">ASE Governance Framework</span>
             </span>
             <span class="iconify tabler--arrow-right text-slate-400 dark:text-white/40 mt-4 group-hover:translate-x-1 transition-transform"></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Events Showcase -->
  <section class="py-32 bg-slate-50 dark:bg-white/5 relative overflow-hidden transition-colors duration-500">
     <!-- Decorative Elements -->
     <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none opacity-50 dark:opacity-100"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
        <div>
          <h2 class="text-5xl md:text-6xl font-black mb-4 text-black dark:text-4xl dark:md:text-5xl dark:font-bold dark:text-white">Flagship Experiences</h2>
          <p class="text-xl text-black font-bold dark:text-xl dark:text-white/60 dark:font-normal">Events that set the industry standard.</p>
        </div>
        <a href="/events/" class="flex items-center gap-2 text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors font-medium">
          View All Events <span class="iconify tabler--arrow-right"></span>
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {events.map((event) => (
          <div class="group relative aspect-square rounded-xl overflow-hidden cursor-pointer hover:shadow-2xl hover:shadow-blue-500/20 transition-all duration-300 bg-slate-900 border border-transparent dark:border-white/10">
            <img src={event.image} alt={event.name} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
            
            <div class="absolute bottom-0 left-0 p-4 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300 w-full">
              <span class="inline-block px-2 py-0.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[10px] font-bold mb-2 uppercase tracking-wider text-white">{event.category}</span>
              <h3 class="text-lg font-bold mb-1 leading-tight text-white">{event.name}</h3>
              <div class="h-0.5 w-8 bg-gradient-to-r from-blue-500 to-green-500 rounded-full mb-0 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership/Testimonials -->
  <section class="py-32 bg-white dark:bg-transparent transition-colors duration-500">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
           <h2 class="text-5xl md:text-6xl font-black mb-8 text-black dark:text-4xl dark:md:text-5xl dark:font-bold dark:text-white">Leadership <br/><span class="text-gradient">Perspectives</span></h2>
           <p class="text-xl text-black font-bold mb-10 leading-relaxed dark:text-lg dark:text-white/60 dark:font-normal">
             Our leadership team is committed to fostering an environment where innovation thrives. 
             We believe in empowering every member to reach their full potential through mentorship, 
             opportunity, and community support.
           </p>
           <a href="/team/" class="inline-block px-8 py-4 border border-slate-200 dark:border-white/20 text-slate-900 dark:text-white font-bold rounded-lg hover:bg-slate-50 dark:hover:bg-white/5 transition-colors uppercase tracking-wider text-sm">Meet the Team</a>
        </div>

        <div class="grid gap-6">
          {testimonials.map((t) => (
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm dark:bg-white/5 dark:border-white/5 dark:shadow-none hover:border-slate-300 dark:hover:border-white/10 transition-colors">
              <div class="flex items-start gap-4">
                 <img src={t.image} alt={t.name} class="w-16 h-16 rounded-full object-cover border-2 border-slate-200 dark:border-white/10" />
                 <div>
                   <p class="text-lg italic text-slate-700 dark:text-white/80 mb-4">"{t.quote}"</p>
                   <div>
                     <h4 class="font-bold text-slate-900 dark:text-white">{t.name}</h4>
                     <p class="text-sm text-blue-600 dark:text-blue-400">{t.role}</p>
                   </div>
                 </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-32 relative overflow-hidden bg-white dark:bg-transparent transition-colors duration-500">
    <div class="absolute inset-0 bg-gradient-to-b from-blue-50 via-transparent to-transparent dark:from-blue-900/10 dark:via-transparent dark:to-transparent"></div>
    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="text-5xl md:text-7xl font-bold mb-8 tracking-tight text-slate-900 dark:text-white">
        Ready to <span class="italic text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-green-500 dark:from-blue-400 dark:to-green-400 pr-4">Make History?</span>
      </h2>
      <p class="text-xl text-slate-600 dark:text-white/60 mb-12 max-w-2xl mx-auto">
        The application window is open. Don't miss your chance to be part of the legacy.
      </p>
      
      <a href={joinLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-10 py-5 bg-blue-600 text-white hover:bg-blue-700 dark:bg-white dark:text-black text-lg font-bold rounded-full hover:scale-105 transition-transform hover:shadow-[0_0_40px_rgba(37,99,235,0.3)] dark:hover:shadow-[0_0_40px_rgba(255,255,255,0.3)]">
        <span class="iconify tabler--rocket"></span>
        Start Application
      </a>
      
      <p class="mt-8 text-sm text-slate-400 dark:text-white/40">
        Limited spots available for the 2026 intake.
      </p>
    </div>
  </section>

</PageLayout>

<style>

  /* Blobs for Hero */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite;
  }

  .blob-blue-1 {
    width: 600px;
    height: 600px;
    background: #3b82f6;
    top: -20%;
    left: -20%;
    animation-delay: 0s;
  }

  .blob-green-1 {
    width: 500px;
    height: 500px;
    background: #10b981;
    bottom: -10%;
    right: -10%;
    animation-delay: 4s;
  }
  
  .blob-blue-2 {
    width: 400px;
    height: 400px;
    background: #2563eb;
    top: 30%;
    right: 20%;
    animation-delay: 8s;
  }
  
  .blob-purple-1 {
    width: 450px;
    height: 450px;
    background: #8b5cf6;
    bottom: 10%;
    left: 10%;
    animation-delay: 12s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }

  .animate-pulse-slow {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  .delay-300 { animation-delay: 0.3s; }
  .delay-1000 { animation-delay: 1s; }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bg-gradient-radial {
    background-image: radial-gradient(var(--tw-gradient-stops));
  }

  /* Custom Scrollbar for this page if needed, though global usually handles it */
  section {
    position: relative;
  }

  /* Gradient Text Utility Wrapper */
  .text-gradient {
    /* Manually replaced @apply with properties to avoid build error */
    background-clip: text;
    -webkit-background-clip: text; /* Safari support */
    color: transparent;
    background-image: linear-gradient(to right, #60a5fa, #4ade80); /* blue-400 to green-400 */
  }
</style>
