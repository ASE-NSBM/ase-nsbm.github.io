---
import PageLayout from '@/layouts/PageLayout.astro'
import { Image } from 'astro:assets'
import logo from '@/assets/logo.svg'

const frontmatter = {
  title: 'About Us | Association of Software Engineering',
  description: 'Innovate. Collaborate. Excel. Learn about our mission, vision, and history.',
  activeHeaderLink: 'About',
  searchable: true,
  fullWidth: true
}

const timeline = [
  {
    year: '2024',
    title: 'The Inception',
    desc: 'Established as the Student Circle of Software Engineering under the Dept. of Software Engineering and Information Systems.',
    icon: 'tabler--bulb'
  },
  {
    year: '2024',
    title: 'Foundations Laid',
    desc: 'Organized inaugural events including GreenEXE 2.0 and MadFest, setting the standard for student-led initiatives.',
    icon: 'tabler--flag'
  },
  {
    year: '2025',
    title: 'A New Era',
    desc: 'Rebranded as the "Association of Software Engineering" (ASE) to reflect our expanding scope and influence within the university.',
    icon: 'tabler--rocket'
  }
]

// Join Us / Team placeholder image - ensure this exists or use a valid one from public
// Using a placeholder from the previous file or a generic one if not found.
// The previous file had '/joinus.webp', assuming it exists in public.
const teamImage = '/joinus.webp' 
---

<PageLayout {frontmatter}>
  
  <!-- Hero Section -->
  <section class="relative min-h-[80vh] flex flex-col items-center justify-center overflow-hidden pt-20 pb-10 bg-slate-100 dark:bg-transparent transition-colors duration-500">
    <!-- Animated Background -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-60 dark:opacity-100 transition-opacity duration-500">
      <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[100px] animate-pulse-slow"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-green-600/10 rounded-full blur-[100px] animate-pulse-slow delay-1000"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-gradient-radial from-white/5 to-transparent blur-3xl dark:opacity-100 opacity-0"></div>
    </div>

    <div class="container relative z-10 mx-auto px-4 text-center">
      <div class="mb-8 relative inline-block">
         <!-- Glowing Logo Backdrop -->
         <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl animate-pulse-slow"></div>
         <Image src={logo} alt="ASE Logo" class="w-24 h-24 md:w-32 md:h-32 relative z-10 mb-8 mx-auto drop-shadow-2xl animate-fade-in-up" />
      </div>

      <div class="mb-12 relative inline-block">
         <!-- Watermark Title -->
         <h1 class="relative text-7xl md:text-9xl font-black tracking-tighter leading-none mb-2 animate-fade-in-up delay-100 select-none text-slate-200 dark:text-white dark:mix-blend-overlay dark:opacity-10 opacity-50">
            TOGETHER
         </h1>
         <h1 class="relative text-5xl md:text-7xl font-black tracking-tighter leading-none -mt-8 md:-mt-16 mb-6 animate-fade-in-up delay-200 z-10 drop-shadow-2xl">
            <span class="text-black dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-b dark:from-white dark:via-white dark:to-white/40">WE INNOVATE</span>
         </h1>
      </div>

      <p class="text-xl md:text-2xl text-slate-600 dark:text-white/60 max-w-3xl mx-auto mb-12 leading-relaxed animate-fade-in-up delay-300 font-medium dark:font-light">
        The Association of Software Engineering (ASE) is the premier student body for tech innovation at NSBM.
      </p>

      <div class="flex gap-4 justify-center animate-fade-in-up delay-300">
        <a href="#mission" class="px-8 py-3 bg-black text-white dark:bg-white dark:text-black rounded-full font-bold hover:scale-105 transition-transform">
          Our Mission
        </a>
      </div>
    </div>
  </section>

  <!-- Mission & Vision (Bento Grid) -->
  <section id="mission" class="py-32 bg-white dark:bg-transparent transition-colors duration-500 relative">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        
        <!-- Mission Card -->
        <div class="group relative p-10 rounded-3xl bg-slate-50 border border-slate-200 dark:bg-white/5 dark:border-white/10 dark:backdrop-blur-sm overflow-hidden hover:shadow-xl dark:hover:shadow-blue-500/10 transition-all duration-300">
          <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition-opacity">
            <span class="iconify tabler--target text-9xl text-blue-500"></span>
          </div>
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center mb-6">
              <span class="iconify tabler--target text-3xl text-blue-600 dark:text-blue-400"></span>
            </div>
            <h2 class="text-4xl font-black mb-6 text-black dark:text-white">Our Mission</h2>
            <p class="text-lg text-slate-700 dark:text-white/70 leading-relaxed">
              To empower software engineering students by providing opportunities for professional growth, networking, and skill development. We strive to bridge the gap between academia and industry.
            </p>
          </div>
        </div>

        <!-- Vision Card -->
        <div class="group relative p-10 rounded-3xl bg-slate-50 border border-slate-200 dark:bg-white/5 dark:border-white/10 dark:backdrop-blur-sm overflow-hidden hover:shadow-xl dark:hover:shadow-green-500/10 transition-all duration-300">
          <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition-opacity">
            <span class="iconify tabler--eye text-9xl text-green-500"></span>
          </div>
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-green-500/10 flex items-center justify-center mb-6">
              <span class="iconify tabler--eye text-3xl text-green-600 dark:text-green-400"></span>
            </div>
            <h2 class="text-4xl font-black mb-6 text-black dark:text-white">Our Vision</h2>
            <p class="text-lg text-slate-700 dark:text-white/70 leading-relaxed">
              To create a dynamic community where students can collaborate, innovate, and contribute meaningfully to the field of software engineering, defining the future of technology in Sri Lanka.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Evolution Timeline -->
  <section class="py-32 bg-slate-50 dark:bg-transparent transition-colors duration-500 relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 pointer-events-none">
       <div class="absolute left-1/2 top-0 bottom-0 w-[1px] bg-gradient-to-b from-transparent via-slate-300 dark:via-white/20 to-transparent"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-black mb-6 text-black dark:text-white">The Evolution</h2>
        <p class="text-lg text-slate-600 dark:text-white/50">Our journey from a circle to a movement.</p>
      </div>

      <div class="max-w-4xl mx-auto flex flex-col gap-12 relative z-10">
        {timeline.map((item, index) => (
          <div class={`flex flex-col md:flex-row items-center gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse md:text-right'} group`}>
            
            <!-- Content -->
            <div class={`flex-1 text-center ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
              <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 dark:bg-blue-500/20 dark:text-blue-300 rounded-full text-sm font-bold mb-3">{item.year}</span>
              <h3 class="text-2xl font-bold text-black dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{item.title}</h3>
              <p class="text-slate-600 dark:text-white/60">{item.desc}</p>
            </div>

            <!-- Center Dot -->
            <div class="relative flex-none w-12 h-12 flex items-center justify-center">
              <div class="absolute inset-0 bg-white dark:bg-black border-4 border-slate-200 dark:border-white/10 rounded-full group-hover:border-blue-500 transition-colors z-10"></div>
              <span class={`iconify ${item.icon} text-lg text-slate-400 dark:text-white/40 relative z-20 group-hover:text-blue-500 transition-colors`}></span>
            </div>

            <!-- Spacer for alignment -->
            <div class="hidden md:block flex-1"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Community / Team CTA -->
  <section class="py-32 bg-white dark:bg-transparent transition-colors duration-500">
    <div class="container mx-auto px-4">
      <div class="relative rounded-[3rem] overflow-hidden bg-slate-900 dark:bg-white/5 border border-slate-800 dark:border-white/10 flex flex-col lg:flex-row">
        
        <!-- Content Side -->
        <div class="relative z-10 p-12 md:p-20 lg:w-1/2 flex flex-col justify-center">
          <h2 class="text-4xl md:text-5xl font-black text-white mb-6">Join the <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-green-400">Community</span></h2>
          <p class="text-lg text-white/70 mb-8 leading-relaxed">
            Whether you're into coding, design, or leadership, ASE is your platform. Connect with 100+ active members and industry experts.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://chat.whatsapp.com/HVcDnZ380tpAooloxgLS8F" target="_blank" class="px-6 py-3 bg-green-500 hover:bg-green-400 text-black font-bold rounded-xl transition-all flex items-center gap-2 text-sm md:text-base">
              <span class="iconify tabler--brand-whatsapp text-xl"></span>
              WhatsApp
            </a>
            <a href="/intake" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl backdrop-blur-md border border-white/10 transition-all text-sm md:text-base">
              Apply 2026
            </a>
          </div>
        </div>

        <!-- Image Side -->
        <div class="relative lg:w-1/2 min-h-[300px] lg:min-h-full">
           <img src={teamImage} alt="ASE Community" class="absolute inset-0 w-full h-full object-cover object-[50%_35%]" />
           
           <!-- Blending Gradients -->
           <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-slate-900 dark:from-black/80 to-transparent lg:block hidden"></div>
           <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-slate-900 dark:from-black/80 to-transparent lg:hidden block"></div>
           <!-- Overlay for dark mode blending fix -->
           <div class="absolute inset-0 bg-blue-500/10 mix-blend-overlay"></div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>

<style>
  /* Local animations if not present in global */
  .animate-pulse-slow {
    animation: pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: .5; transform: scale(1); }
    50% { opacity: .8; transform: scale(1.05); }
  }

  .bg-gradient-radial {
    background-image: radial-gradient(var(--tw-gradient-stops));
  }
</style>
