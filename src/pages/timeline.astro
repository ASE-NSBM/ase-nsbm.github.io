    tags: ['competition', 'python']
  },
  {
    id: 'greenexe-3-product',
    title: 'GreenEXE 3.0 – Product Mentorship',
    date: 'September 2025',
    exactDate: new Date('2025-09-10'),
    description:
      'The first stage of GreenEXE 3.0 where participants refine their product ideas through structured mentorship, focusing on solution design, feasibility, and innovation. Done by an industry expert with Product Mentorship experience.',
    image: '/events/GreenEXE3.0ProductMentorship.webp',
    tags: ['mentorship', 'product', 'GreenEXE']
  },
  {
    id: 'greenexe-3-research',
    title: 'GreenEXE 3.0 – Research Mentorship',
    date: 'September 2025',
    exactDate: new Date('2025-09-20'),
    description:
      'A dedicated mentoring phase to guide participants in integrating research-backed validation and advanced technical concepts into their projects. Done by Dr. Mohomed Shafraz – Associate Professor connecting NSBM roots and years of expertise.',
    image: '/events/GreenEXE3.0ResearchMentorship.webp',
    tags: ['mentorship', 'research', 'GreenEXE']
  },
  {
    id: 'greenexe-3-competition',
    title: 'GreenEXE 3.0 – Competition Round',
    date: 'September 2025',
    exactDate: new Date('2025-09-28'),
    description:
      'The competitive evaluation phase where teams present their developed solutions to a panel of academic and industry judges, emphasizing innovation and execution.',
