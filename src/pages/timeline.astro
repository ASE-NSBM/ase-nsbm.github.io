]

// Sort newest first (reverse chronological)
const sortedEvents = [...events].sort(
  (a, b) => b.exactDate.getTime() - a.exactDate.getTime()
)

// Extract unique years and months for filtering
const years = [...new Set(events.map(e => e.exactDate.getFullYear()))].sort((a, b) => b - a)
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']

const today = new Date()
---

<PageLayout {frontmatter}>
  <div class="timeline-hero scroll-reveal">
    <h1 class="timeline-title text-gradient">Legacy & Future</h1>
    <p class="timeline-subtitle">
      A curated showcase of our journey, milestones, and upcoming adventures.
    </p>

    <div class="filter-controls">
      <!-- Year Filters -->
      <div class="year-filters">
        <button class="filter-btn year-btn active" data-year="all">All Years</button>
        {years.map(year => (
          <button class="filter-btn year-btn" data-year={year}>{year}</button>
        ))}
      </div>
      
      <!-- Month Filters (shown when year is selected) -->
      <div class="month-filters" id="monthFilters" style="display: none;">
        {monthNames.map((month, idx) => (
          <button class="filter-btn month-btn" data-month={idx}>{month}</button>
        ))}
      </div>
    </div>
  </div>

  <div class="timeline-grid">
    {
      sortedEvents.map((event, index) => {
        const isPast = event.exactDate.getTime() < today.getTime()
        // Make the first item span full width as a 'Featured' event potentially, or just keep strict grid?
        // Let's keep strict grid for cleanliness.
        return (
          <div 
            class={`grid-card glass hover-lift scroll-reveal-up ${isPast ? 'past' : 'future'}`} 
            data-year={event.exactDate.getFullYear()}
            data-month={event.exactDate.getMonth()}
            style={`animation-delay: ${index * 50}ms`}
          >
            <div class="card-image-wrapper">
                <img src={event.image} alt={event.title} loading="lazy" />
                <div class="status-badge" data-status={isPast ? 'done' : 'next'}>
                    {isPast ? 'Done' : 'Up Next'}
                </div>
            </div>
            
            <div class="card-body">
                <div class="meta-row">
                    <span class="date">{event.date}</span>
                    <div class="tags">
                        {event.tags.slice(0, 1).map(tag => <span class="tag">#{tag}</span>)}
                    </div>
                </div>
                <h3 class="title">{event.title}</h3>
                <p class="desc">{event.description}</p>
            </div>
          </div>
        )
      })
    }
  </div>
</PageLayout>

<style>
  /* Base Styles */
  .timeline-hero {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
  }

  .timeline-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -1px;
    background: linear-gradient(135deg, rgb(var(--accent)), #fff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .timeline-subtitle {
    font-size: 1.1rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto;
  }

  .filter-controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  
  .year-filters, .month-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  
  .month-filters {
    max-width: 800px;
  }

  .filter-btn {
    padding: 0.4rem 1.2rem;
    font-size: 0.9rem;
    border-radius: 99px;
    background: transparent;
    border: 1px solid rgba(var(--accent), 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
  }

  .filter-btn.active, .filter-btn:hover {
    background: rgba(var(--accent), 0.15);
    border-color: rgb(var(--accent));
    color: rgb(var(--accent));
  }
  
  .filter-btn.active {
    background: rgb(var(--accent));
    color: white;
  }

  /* Grid Layout */
  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); /* Responsive grid */
    gap: 2rem;
    padding-bottom: 4rem;
    width: 100%;
  }

  /* Card Design - "Bento" Style */
  .grid-card {
    background: rgba(var(--accent), 0.03);
    border: 1px solid rgba(var(--accent), 0.1);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    animation: fadeInUp 0.6s forwards;
    height: 100%; /* Equal height rows */
  }
  
  .grid-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    border-color: rgba(var(--accent), 0.4);
    background: rgba(var(--accent), 0.05);
  }
  
  :global(.dark) .grid-card {
    background: rgba(255,255,255, 0.03);
    border-color: rgba(255,255,255, 0.1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }

  .card-image-wrapper {
    position: relative;
    height: 220px;
    width: 100%;
    overflow: hidden;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  
  .grid-card:hover .card-image-wrapper img {
    transform: scale(1.08); /* Slow zoom */
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }
  
  .status-badge[data-status="done"] {
    background: rgba(0, 0, 0, 0.7);
    color: white;
  }
  
  .status-badge[data-status="next"] {
    background: rgb(var(--accent));
    color: white;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .date {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.7;
    letter-spacing: 0.5px;
  }

  .tag {
    font-size: 0.7rem;
    background: rgba(var(--accent), 0.1);
    color: rgb(var(--accent));
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
    line-height: 1.25;
  }

  .desc {
    font-size: 0.95rem;
    opacity: 0.75;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 4; /* Limit lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive Adjustments */
  @media (max-width: 640px) {
    .timeline-grid {
        grid-template-columns: 1fr; /* 1 col on mobile */
        gap: 1.5rem;
    }
    
    .timeline-title {
        font-size: 2.5rem;
    }
    
    .card-image-wrapper {
        height: 200px;
    }
  }
</style>

<script>
  function setupFilter() {
    const yearBtns = document.querySelectorAll('.year-btn')
    const monthBtns = document.querySelectorAll('.month-btn')
    const monthFilters = document.getElementById('monthFilters')
    const cards = document.querySelectorAll('.grid-card')
    
    let selectedYear = 'all'
    let selectedMonth = null
    
    // Year filter logic
    yearBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            yearBtns.forEach(b => b.classList.remove('active'))
            btn.classList.add('active')
            
            selectedYear = btn.dataset.year
            selectedMonth = null // Reset month selection
            
            // Show/hide month filters
            if (selectedYear === 'all') {
                monthFilters.style.display = 'none'
            } else {
                monthFilters.style.display = 'flex'
                // Reset month button states
                monthBtns.forEach(mb => mb.classList.remove('active'))
            }
            
            filterCards()
        })
    })
    
    // Month filter logic
    monthBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const month = btn.dataset.month
            
            // Toggle month selection
            if (selectedMonth === month) {
                selectedMonth = null
                btn.classList.remove('active')
            } else {
                monthBtns.forEach(mb => mb.classList.remove('active'))
                selectedMonth = month
                btn.classList.add('active')
            }
            
            filterCards()
        })
    })
    
    function filterCards() {
        cards.forEach(card => {
            const cardYear = card.dataset.year
            const cardMonth = card.dataset.month
            
            let shouldShow = true
            
            // Year filter
            if (selectedYear !== 'all' && cardYear !== selectedYear) {
                shouldShow = false
            }
            
            // Month filter (only if year is selected)
            if (selectedYear !== 'all' && selectedMonth !== null && cardMonth !== selectedMonth) {
                shouldShow = false
            }
            
            if (shouldShow) {
                card.style.display = 'flex'
                setTimeout(() => card.style.opacity = '1', 50)
            } else {
                card.style.opacity = '0'
                setTimeout(() => card.style.display = 'none', 300)
            }
        })
    }
  }

  document.addEventListener('astro:page-load', setupFilter)
  document.addEventListener('DOMContentLoaded', setupFilter)
</script>
