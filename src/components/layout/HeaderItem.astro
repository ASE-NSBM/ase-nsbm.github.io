---
import type { NavItem } from '@/types'
import { isAbsolute } from '@/util'
import type { JSX } from 'astro/jsx-runtime'

export interface Props {
  item: NavItem
  isActive?: boolean
  role?: JSX.AriaRole
}

const {
  isActive = false,
  item: { href, icon, label },
  role
} = Astro.props
---

<a
  href={href}
  class={`flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 text-sm font-medium ${
    isActive 
      ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20' 
      : 'text-slate-600 dark:text-slate-300 hover:bg-white dark:hover:bg-white/10 hover:text-slate-900 dark:hover:text-white'
  }`}
  target={isAbsolute(href) ? '_blank' : '_self'}
  {role}
>
  {icon && <span class={`iconify text-lg ${icon}`} />}
  <span>
    {label}
  </span>
</a>
