---
import logo from '@/assets/logo.svg'
import Dropdown from '@/components/Dropdown.astro'
import HeaderItem from '@/components/layout/HeaderItem.astro'
import MobileNavToggle from '@/components/layout/MobileNavToggle.astro'
import ModeToggle from '@/components/mode/ModeToggle.astro'
import config from '@/theme.config'
import type {
  HeaderItem as HeaderItemType,
  NavItem as NavItemType
} from '@/types'
import { Image } from 'astro:assets'

export interface Props {
  activeHeaderLink?: string
}

const { activeHeaderLink } = Astro.props

export const isNavItem = (item: HeaderItemType): item is NavItemType =>
  Object.hasOwn(item, 'href')
---

<header class="fixed top-0 w-full z-50 transition-all duration-300" id="main-header">
  <div class="absolute inset-0 bg-white/70 dark:bg-slate-950/70 backdrop-blur-md border-b border-slate-200/50 dark:border-white/10 transition-colors duration-300"></div>
  
  <div class="relative mx-auto w-full max-w-[95%] md:max-w-7xl h-16 sm:h-20 flex items-center justify-between px-4 sm:px-6">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 py-2 px-4 bg-blue-600 text-white rounded-md">
      Skip to main content
    </a>

    <!-- Logo Section -->
    <!-- Logo Section -->
    <a href="/" class="flex items-center gap-3 relative z-50">
      <Image alt="ASE Logo" src={logo} class="h-14 w-auto object-contain" loading="eager" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      <ul class="flex items-center gap-1 p-1 rounded-full bg-slate-100/50 dark:bg-white/5 border border-slate-200/50 dark:border-white/5 backdrop-blur-sm">
        {
          config.navbarItems.map((item) => (
            <li>
              {isNavItem(item) ? (
                <HeaderItem
                  {item}
                  isActive={
                    activeHeaderLink === item.label ||
                    activeHeaderLink === item.href
                  }
                />
              ) : (
                <Dropdown {item} {activeHeaderLink} />
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-3 sm:gap-4 relative z-50">
      <a href="/search/" class="p-2 rounded-full text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors" aria-label="Search">
        <span class="iconify tabler--search text-xl"></span>
      </a>
      
      <div class="hidden sm:block">
        {config.modeToggle && <ModeToggle />}
      </div>

      <!-- Mobile Toggle -->
      <div class="md:hidden">
        <MobileNavToggle />
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div id="mobile-nav" class="fixed inset-0 z-40 bg-white/95 dark:bg-slate-950/95 backdrop-blur-xl transform translate-x-full transition-transform duration-500 ease-out-expo data-[state=open]:translate-x-0 md:hidden flex flex-col pt-24 pb-8 px-6 overflow-y-auto">
    <nav class="flex-1 flex flex-col justify-center items-center gap-8">
      <ul class="flex flex-col items-center gap-6 w-full max-w-sm">
        {
          config.navbarItems.map((item, index) => (
            <li class="w-full opacity-0 translate-y-4 transition-all duration-500 delay-[var(--delay)]" style={`--delay: ${100 + index * 50}ms`}>
              {isNavItem(item) ? (
                 <a 
                  href={item.href} 
                  class:list={[
                    "block w-full text-center text-3xl font-bold py-2 transition-colors duration-300",
                    activeHeaderLink === item.label || activeHeaderLink === item.href
                      ? "text-blue-600 dark:text-blue-400" 
                      : "text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400"
                  ]}
                >
                  {item.label}
                </a>
              ) : (
                 <div class="text-center">
                    <span class="block text-sm font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-4">{item.label}</span>
                    <ul class="flex flex-col gap-4">
                      {item.children?.map(child => (
                        <li>
                          <a href={child.href} class="text-2xl font-semibold text-slate-800 dark:text-slate-200 hover:text-blue-600 dark:hover:text-blue-400 px-4 py-2 block">
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                 </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    
    <div class="mt-auto flex flex-col items-center gap-6 opacity-0 translate-y-4 transition-all duration-500 delay-500 mobile-nav-footer">
       <div class="flex items-center gap-4">
          {config.modeToggle && <ModeToggle />}
       </div>
       <p class="text-xs text-slate-400 text-center">
          &copy; {new Date().getFullYear()} {config.title}
       </p>
    </div>
  </div>
</header>

<style>
  .ease-out-expo {
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  #mobile-nav[data-state="open"] li,
  #mobile-nav[data-state="open"] .mobile-nav-footer {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Header scroll effect
  const header = document.getElementById('main-header');
  const bg = header?.querySelector('.absolute');
  
  if (header && bg) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        header.classList.add('shadow-sm');
        bg.classList.add('shadow-sm');
      } else {
        header.classList.remove('shadow-sm');
         bg.classList.remove('shadow-sm');
      }
    });
  }
</script>
